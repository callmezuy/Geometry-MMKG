+def gm_write_ranks():
+    """[Geometry-MMKG] --rank-file: one row per line of the evaluated split (file order); rank_tail from the forward
+    pass, rank_head from the backward (inverse relation) pass. Tab-separated: relations contain spaces."""
+    if not args.rank_file:
+        return
+    fwd, bwd = GM_RANKS[(args.rank_tensor, 'forward')], GM_RANKS[(args.rank_tensor, 'backward')]
+    if args.knn_topk > 0:
+        i = min(range(len(knn_lambda_list)), key=lambda j: abs(knn_lambda_list[j] - args.rank_lambda))
+        r_tail, r_head, lam = fwd[1][i], bwd[1][i], knn_lambda_list[i]
+    else:
+        r_tail, r_head, lam = fwd[0], bwd[0], None
+    assert len(r_tail) == len(r_head) == len(fwd[2]), (len(r_tail), len(r_head), len(fwd[2]))
+    with open(args.rank_file, 'w', encoding='utf-8') as f:
+        f.write('head_id\trelation\ttail_id\trank_head\trank_tail\n')
+        for (h, r, t), rh, rt in zip(fwd[2], r_head, r_tail):
+            f.write('{}\t{}\t{}\t{}\t{}\n'.format(h, r, t, rh, rt))
+    logger.info('[Geometry-MMKG] wrote {} strict ranks ({} table, lambda {}) to {}'.format(
