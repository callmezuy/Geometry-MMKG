+    @torch.no_grad()
+    def get_strict_metrics(self, model, split='test', rank_file=None):
+        """[Geometry-MMKG] Filtered link prediction with the strict tie rule of the thesis protocol: rank = 1 + number of
+        candidates scoring strictly higher than the answer, the other true answers (train + valid + test, the
+        same sets as get_validation_pred) excluded; every entity is a candidate; head and tail. The score is the
+        model's own (mean of the four predictions, as get_validation_pred). rank_file: CSV
+        h_id,r_id,t_id,rank_head,rank_tail in the order of the split file."""
+        if split == 'val':
+            sides = {'head': self.val_head_indices, 'tail': self.val_tail_indices}
+            triples = self.val_triples
+        else:
+            sides = {'head': self.test_head_indices, 'tail': self.test_tail_indices}
+            triples = self.test_triples
+        ranks = {}
+        for side, indices in sides.items():
+            out = []
+            for start in range(0, len(indices), self.batch_size):
+                batch = indices[start:start + self.batch_size]
+                q = torch.LongTensor([indice['triple'] for indice in batch]).to(self.device)
+                pred, _ = model.forward(q)
+                score = (pred[0] + pred[1] + pred[2] + pred[3]) / 4.0
+                b = torch.arange(len(batch), device=self.device)
+                target = q[:, 2]
+                rows = np.concatenate([np.full(len(indice['label']), i, dtype=np.int64)
+                                       for i, indice in enumerate(batch)])
+                cols = np.concatenate([np.asarray(indice['label'], dtype=np.int64) for indice in batch])
+                known = torch.zeros_like(score, dtype=torch.bool)
+                known[torch.from_numpy(rows).to(self.device), torch.from_numpy(cols).to(self.device)] = True
+                known[b, target] = False
+                better = (score > score[b, target].unsqueeze(1)) & ~known
+                out.append((better.sum(dim=1) + 1).cpu())
+            ranks[side] = torch.cat(out).numpy()
+        r = np.concatenate([ranks['head'], ranks['tail']]).astype(np.float64)
+        metrics = {"Hits@100": float(np.mean(r <= 100)), "Hits@10": float(np.mean(r <= 10)),
+                   "Hits@3": float(np.mean(r <= 3)), "Hits@1": float(np.mean(r <= 1)),
+                   "MR": float(r.mean()), "MRR": float(np.mean(1.0 / r))}
+        if rank_file:
+            with open(rank_file, 'w') as f:
+                f.write('h_id,r_id,t_id,rank_head,rank_tail\n')
+                for (h, rel, t), rh, rt in zip(triples, ranks['head'], ranks['tail']):
+                    f.write(f'{h},{rel},{t},{int(rh)},{int(rt)}\n')
+        return metrics
+
